<!-- Used instead of src/main's manifest when the app links expo-notifications (see build.gradle): above Expo's own
     service (priority -1), this one receives every FCM message and hands Reception's replies to the SDK, the rest to
     Expo. See ANDROID-PUSH-DESIGN.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service
      android:name="sh.reception.reactnative.ReceptionExpoMessagingService"
      android:exported="false">
      <intent-filter android:priority="10">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
