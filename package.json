{
  "name": "react-native-reception",
  "version": "1.2.1",
  "description": "Native Reception support chat for React Native and Expo on iOS.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "build",
    "src",
    "ios",
    "vendor",
    "expo-module.config.json",
    "app.plugin.js",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "homepage": "https://reception.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reception-sh/reception-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/reception-sh/reception-react-native/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "ios",
    "support",
    "chat",
    "customer-support",
    "in-app-chat"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run format:check",
    "test": "jest --runInBand",
    "sync:ios": "node scripts/sync-ios-sdk",
    "check:ios": "node scripts/check-ios-sdk",
    "prepack": "npm run check:ios && npm run build",
    "test:native": "node scripts/test-native",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": ">=19.1.0",
    "react-native": ">=0.81.0",
    "expo-notifications": ">=0.32.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.5",
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-notifications": "~57.0.22",
    "jest": "^30.5.2",
    "jest-util": "^30.5.1",
    "prettier": "3.8.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./expo-notifications": {
      "types": "./build/expo-notifications.d.ts",
      "react-native": "./src/expo-notifications.ts",
      "default": "./build/expo-notifications.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "expo-notifications": {
      "optional": true
    }
  }
}
